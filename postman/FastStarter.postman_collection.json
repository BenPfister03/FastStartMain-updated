                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const schema = {",
                  "  type: 'array',",
                  "  items: {",
                  "    type: 'object',",
                  "    properties: {",
                  "      listingId: { type: 'integer' }, ownerId: { type: 'integer' }, gameId: { type: 'integer' },",
                  "      condition: { type: 'string' }, status: { type: 'string' }, price: { type: 'number' },",
                  "      game: { type: 'object', properties: { gameId: { type: 'integer' }, title: { type: 'string' }, platform: { type: 'string' } },",
                  "              required: ['gameId', 'title', 'platform'] }",
                  "    },",
                  "    required: ['listingId', 'ownerId', 'gameId', 'condition', 'status', 'price', 'game']",
                  "  }",
                  "};",
                  "pm.test('Schema is valid', () => pm.response.to.have.jsonSchema(schema));",
                  "pm.test('Created listing is returned', () => {",
                  "  const id = Number(pm.collectionVariables.get('listingId'));",
                  "  pm.expect(pm.response.json().map(l => l.listingId)).to.include(id);",
                  "});",
                  "pm.test('Only NSW games returned', () => pm.response.json().forEach(l => pm.expect(l.game.platform).to.eql('NSW')));"
